generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model adjusted_products {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  adjustment_id BigInt      @db.UnsignedBigInt
  product_id    BigInt      @db.UnsignedBigInt
  quantity      Int
  type          String      @db.VarChar(255)
  created_at    DateTime?   @db.Timestamp(0)
  updated_at    DateTime?   @db.Timestamp(0)
  adjustments   adjustments @relation(fields: [adjustment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "adjusted_products_adjustment_id_foreign")

  @@index([adjustment_id], map: "adjusted_products_adjustment_id_foreign")
}

model adjustments {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  date              DateTime            @db.Date
  reference         String              @db.VarChar(255)
  note              String?             @db.Text
  created_at        DateTime?           @db.Timestamp(0)
  updated_at        DateTime?           @db.Timestamp(0)
  adjusted_products adjusted_products[]
}

model approval_request_logs {
  id                  Int                          @id @default(autoincrement()) @db.UnsignedInt
  approval_request_id BigInt                       @db.UnsignedBigInt
  user_id             BigInt?                      @db.UnsignedBigInt
  action              approval_request_logs_action
  comment             String?                      @db.Text
  level               Int?                         @db.UnsignedInt
  created_at          DateTime?                    @db.Timestamp(0)
  updated_at          DateTime?                    @db.Timestamp(0)
}

model approval_requests {
  id                Int                      @id @default(autoincrement())
  requestable_type  String?                  @db.VarChar(255)
  requestable_id    BigInt?                  @db.UnsignedBigInt
  approval_types_id BigInt                   @db.UnsignedBigInt
  approval_rules_id BigInt?                  @db.UnsignedBigInt
  amount            Decimal                  @db.Decimal(20, 2)
  current_level     Int?                     @db.UnsignedInt
  status            approval_requests_status
  created_by        BigInt?                  @db.UnsignedBigInt
  created_at        DateTime?                @db.Timestamp(0)
  updated_at        DateTime?                @db.Timestamp(0)
}

model approval_rule_levels {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  approval_rules_id   BigInt                @db.UnsignedBigInt
  level               String                @db.VarChar(255)
  amount_limit        Decimal               @db.Decimal(15, 0)
  is_active           Boolean
  created_at          DateTime              @db.Timestamp(0)
  updated_at          DateTime              @db.Timestamp(0)
  approval_rule_users approval_rule_users[]

  @@index([approval_rules_id], map: "approval_rules_id")
}

model approval_rule_users {
  id                      BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  approval_rule_levels_id BigInt                   @db.UnsignedBigInt
  user_id                 BigInt                   @db.UnsignedBigInt
  role                    approval_rule_users_role
  sequence                Int                      @default(0)
  is_active               Boolean                  @default(true)
  created_at              DateTime?                @db.Timestamp(0)
  updated_at              DateTime?                @db.Timestamp(0)
  approval_rule_levels    approval_rule_levels     @relation(fields: [approval_rule_levels_id], references: [id], onUpdate: Restrict, map: "fk_approval_rule_level")

  @@index([approval_rule_levels_id], map: "categories_category_code_unique")
  @@index([user_id], map: "user_id")
}

model approval_rules {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  approval_types_id BigInt    @unique(map: "approval_type_id") @db.UnsignedBigInt
  rule_name         String?   @db.VarChar(255)
  is_active         Boolean
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)

  @@index([approval_types_id], map: "categories_category_code_unique")
}

model approval_types {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  approval_code String    @unique(map: "categories_category_code_unique") @db.VarChar(255)
  approval_name String    @db.VarChar(255)
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
}

model budget_details {
  id               BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  master_budget_id BigInt     @db.UnsignedBigInt
  category_id      BigInt     @db.UnsignedBigInt
  category_name    String     @db.VarChar(255)
  budget           Decimal    @db.Decimal(15, 0)
  percentage       Decimal    @default(0.00) @db.Decimal(8, 2)
  used_amount      Decimal    @default(0.00) @db.Decimal(15, 2)
  created_at       DateTime   @db.Timestamp(0)
  updated_at       DateTime   @db.Timestamp(0)
  categories       categories @relation(fields: [category_id], references: [id], onUpdate: Restrict, map: "budget_details_categories_id")

  @@unique([master_budget_id, category_id], map: "master_budget_id")
  @@index([category_id], map: "budget_details_categories_id")
}

model categories {
  id                                BigInt                              @id @default(autoincrement()) @db.UnsignedBigInt
  category_code                     String                              @unique(map: "categories_category_code_unique") @db.VarChar(255)
  category_name                     String                              @db.VarChar(255)
  created_at                        DateTime?                           @db.Timestamp(0)
  updated_at                        DateTime?                           @db.Timestamp(0)
  budget_details                    budget_details[]
  products                          products[]
  purchase_budget_allocations       purchase_budget_allocations[]
  user_product_group_has_categories user_product_group_has_categories[]
}

model currencies {
  id                 BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  currency_name      String          @db.VarChar(255)
  code               String          @db.VarChar(255)
  symbol             String          @db.VarChar(255)
  thousand_separator String          @db.VarChar(255)
  decimal_separator  String          @db.VarChar(255)
  exchange_rate      Int?
  created_at         DateTime?       @db.Timestamp(0)
  updated_at         DateTime?       @db.Timestamp(0)
  bank_accounts      bank_accounts[]
}

model customers {
  id             BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  customer_name  String         @db.VarChar(255)
  customer_email String         @db.VarChar(255)
  customer_phone String         @db.VarChar(255)
  city           String         @db.VarChar(255)
  country        String         @db.VarChar(255)
  address        String         @db.Text
  created_at     DateTime?      @db.Timestamp(0)
  updated_at     DateTime?      @db.Timestamp(0)
  quotations     quotations[]
  sale_returns   sale_returns[]
  sales          sales[]
}

model departments {
  id              BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  department_code String       @unique(map: "categories_category_code_unique") @db.VarChar(255)
  department_name String       @db.VarChar(255)
  created_at      DateTime?    @db.Timestamp(0)
  updated_at      DateTime?    @db.Timestamp(0)
  warehouses      warehouses[]
}

model expense_categories {
  id                   BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  category_name        String     @db.VarChar(255)
  category_description String?    @db.Text
  created_at           DateTime?  @db.Timestamp(0)
  updated_at           DateTime?  @db.Timestamp(0)
  expenses             expenses[]
}

model expenses {
  id                 BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  category_id        BigInt             @db.UnsignedBigInt
  date               DateTime           @db.Date
  reference          String             @db.VarChar(255)
  details            String?            @db.Text
  amount             Int
  created_at         DateTime?          @db.Timestamp(0)
  updated_at         DateTime?          @db.Timestamp(0)
  expense_categories expense_categories @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "expenses_category_id_foreign")

  @@index([category_id], map: "expenses_category_id_foreign")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model master_budget {
  id                  Int                  @id @default(autoincrement())
  no_budgeting        String               @db.VarChar(255)
  tgl_penyusunan      DateTime             @db.Date
  bulan               String               @db.VarChar(255)
  periode_awal        DateTime             @db.Date
  periode_akhir       DateTime             @db.Date
  department_id       BigInt
  is_mandatory        Boolean              @default(false)
  description         String?              @db.Text
  grandtotal          Decimal              @db.Decimal(18, 0)
  total_percentage    Decimal              @default(0.00) @db.Decimal(8, 2)
  target_sales_id     BigInt?              @db.UnsignedBigInt
  target_sales_amount Decimal              @default(0.00) @db.Decimal(15, 2)
  used_amount         Decimal              @db.Decimal(18, 0)
  reserved_amount     Decimal              @db.Decimal(18, 0)
  status              master_budget_status
  approval_request_id BigInt?              @db.UnsignedBigInt
  created_at          DateTime             @db.Timestamp(0)
  updated_at          DateTime             @db.Timestamp(0)
  created_by          Int?
  target_sales        target_sales?        @relation(fields: [target_sales_id], references: [id], onUpdate: NoAction, map: "master_budget_target_sales_id_foreign")

  @@index([target_sales_id], map: "master_budget_target_sales_id_foreign")
}

model media {
  id                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  model_type            String    @db.VarChar(255)
  model_id              BigInt    @db.UnsignedBigInt
  uuid                  String?   @unique(map: "media_uuid_unique") @db.Char(36)
  collection_name       String    @db.VarChar(255)
  name                  String    @db.VarChar(255)
  file_name             String    @db.VarChar(255)
  mime_type             String?   @db.VarChar(255)
  disk                  String    @db.VarChar(255)
  conversions_disk      String?   @db.VarChar(255)
  size                  BigInt    @db.UnsignedBigInt
  manipulations         Json
  custom_properties     Json
  generated_conversions Json
  responsive_images     Json
  order_column          Int?      @db.UnsignedInt
  created_at            DateTime? @db.Timestamp(0)
  updated_at            DateTime? @db.Timestamp(0)

  @@index([model_type, model_id], map: "media_model_type_model_id_index")
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int
}

model model_has_permissions {
  permission_id BigInt      @db.UnsignedBigInt
  model_type    String      @db.VarChar(255)
  model_id      BigInt      @db.UnsignedBigInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "model_has_permissions_permission_id_foreign")

  @@id([permission_id, model_id, model_type])
  @@index([model_id, model_type], map: "model_has_permissions_model_id_model_type_index")
}

model model_has_roles {
  role_id    BigInt @db.UnsignedBigInt
  model_type String @db.VarChar(255)
  model_id   BigInt @db.UnsignedBigInt
  roles      roles  @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "model_has_roles_role_id_foreign")

  @@id([role_id, model_id, model_type])
  @@index([model_id, model_type], map: "model_has_roles_model_id_model_type_index")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model password_resets {
  email      String    @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)

  @@index([email], map: "password_resets_email_index")
  @@ignore
}

model permissions {
  id                               BigInt                             @id @default(autoincrement()) @db.UnsignedBigInt
  name                             String                             @db.VarChar(255)
  guard_name                       String                             @db.VarChar(255)
  created_at                       DateTime?                          @db.Timestamp(0)
  updated_at                       DateTime?                          @db.Timestamp(0)
  model_has_permissions            model_has_permissions[]
  permission_group_has_permissions permission_group_has_permissions[]
  role_has_permissions             role_has_permissions[]

  @@unique([name, guard_name], map: "permissions_name_guard_name_unique")
}

model pphs {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @db.VarChar(255)
  rate        Float     @default(0.00)
  description String?   @db.VarChar(255)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model ppns {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @db.VarChar(255)
  rate        Float     @default(0.00)
  description String?   @db.VarChar(255)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model product_requests {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  product_id    BigInt?   @db.UnsignedBigInt
  is_mandatory  Boolean   @default(false)
  product_name  String    @db.VarChar(255)
  product_code  String?   @db.VarChar(255)
  category_id   BigInt?   @db.UnsignedBigInt
  product_unit  String    @db.VarChar(255)
  is_asset      Boolean   @default(false)
  product_price Int?
  supplier_id   BigInt?   @db.UnsignedBigInt
  is_verify     Boolean   @default(false)
  status        String    @default("pending") @db.VarChar(255)
  reason        String?   @db.Text
  created_by    BigInt?   @db.UnsignedBigInt
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  products      products? @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "product_requests_product_id_foreign")

  @@index([product_id], map: "product_requests_product_id_foreign")
}

model products {
  id                              BigInt                            @id @default(autoincrement()) @db.UnsignedBigInt
  is_asset                        Boolean                           @default(false)
  category_id                     BigInt                            @db.UnsignedBigInt
  is_mandatory                    Boolean                           @default(false)
  product_name                    String                            @db.VarChar(255)
  product_type                    String?                           @db.VarChar(100)
  bom_code                        String?                           @db.VarChar(100)
  product_code                    String?                           @unique(map: "products_product_code_unique") @db.VarChar(255)
  product_barcode_symbology       String?                           @db.VarChar(255)
  product_quantity                Int
  min_qty                         Int?                              @default(0)
  max_qty                         Int?                              @default(0)
  product_price                   Int
  product_unit                    String?                           @db.VarChar(255)
  product_stock_alert             Int
  product_order_tax               Int?
  product_tax_type                Int?                              @db.TinyInt
  product_note                    String?                           @db.Text
  created_at                      DateTime?                         @db.Timestamp(0)
  updated_at                      DateTime?                         @db.Timestamp(0)
  supplier_id                     BigInt?                           @db.UnsignedBigInt
  part_number                     String?                           @db.VarChar(255)
  tax_item_code                   String?                           @db.VarChar(255)
  goods_receipt_details           goods_receipt_details[]
  material_issuance_details       material_issuance_details[]
  product_locations               product_locations[]
  product_requests                product_requests[]
  product_suppliers               product_suppliers[]
  product_units                   product_units[]
  categories                      categories                        @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "products_category_id_foreign")
  purchase_details                purchase_details[]
  purchase_invoice_details        purchase_invoice_details[]
  purchase_order_details          purchase_order_details[]
  purchase_return_details         purchase_return_details[]
  quotation_details               quotation_details[]
  sale_details                    sale_details[]
  sale_return_details             sale_return_details[]
  stock_opname_details            stock_opname_details[]
  user_product_group_has_products user_product_group_has_products[]
  warehouse_stocks                warehouse_stocks[]
  work_order_materials            work_order_materials[]
  work_orders                     work_orders[]

  @@index([category_id], map: "products_category_id_foreign")
}

model purchase_budget_allocations {
  id                      BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  purchase_id             BigInt      @db.UnsignedBigInt
  purchase_detail_id      BigInt      @db.UnsignedBigInt
  source_master_budget_id BigInt      @db.UnsignedBigInt
  source_budget_detail_id BigInt?     @db.UnsignedBigInt
  target_category_id      BigInt?     @db.UnsignedBigInt
  amount                  Decimal     @default(0.00) @db.Decimal(15, 2)
  is_borrowed_internal    Boolean     @default(false)
  is_borrowed_external    Boolean     @default(false)
  is_applied              Boolean     @default(false)
  created_at              DateTime?   @db.Timestamp(0)
  updated_at              DateTime?   @db.Timestamp(0)
  purchases               purchases   @relation(fields: [purchase_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "purchase_budget_allocations_purchase_id_foreign")
  categories              categories? @relation(fields: [target_category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "purchase_budget_allocations_target_category_id_foreign")

  @@index([purchase_id], map: "purchase_budget_allocations_purchase_id_foreign")
  @@index([target_category_id], map: "purchase_budget_allocations_target_category_id_foreign")
}

model purchase_details {
  id                      BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  purchase_id             BigInt    @db.UnsignedBigInt
  product_id              BigInt?   @db.UnsignedBigInt
  product_name            String    @db.VarChar(255)
  product_code            String    @db.VarChar(255)
  quantity                Int
  price                   Int
  unit_price              Int
  product_unit            String    @db.VarChar(255)
  sub_total               Int
  is_asset                Boolean   @default(false)
  product_discount_amount Int       @default(0)
  product_discount_type   String    @default("fixed") @db.VarChar(255)
  product_tax_amount      Int       @default(0)
  created_at              DateTime? @db.Timestamp(0)
  updated_at              DateTime? @db.Timestamp(0)
  products                products? @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "purchase_details_product_id_foreign")
  purchases               purchases @relation(fields: [purchase_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "purchase_details_purchase_id_foreign")

  @@index([product_id], map: "purchase_details_product_id_foreign")
  @@index([purchase_id], map: "purchase_details_purchase_id_foreign")
}

model purchase_payments {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  purchase_id    BigInt    @db.UnsignedBigInt
  amount         Int
  date           DateTime  @db.Date
  reference      String    @db.VarChar(255)
  payment_method String    @db.VarChar(255)
  note           String?   @db.Text
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
  purchases      purchases @relation(fields: [purchase_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "purchase_payments_purchase_id_foreign")

  @@index([purchase_id], map: "purchase_payments_purchase_id_foreign")
}

model purchase_return_details {
  id                      BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  purchase_return_id      BigInt           @db.UnsignedBigInt
  product_id              BigInt?          @db.UnsignedBigInt
  product_name            String           @db.VarChar(255)
  product_code            String           @db.VarChar(255)
  quantity                Int
  price                   Int
  unit_price              Int
  sub_total               Int
  product_discount_amount Int
  product_discount_type   String           @default("fixed") @db.VarChar(255)
  product_tax_amount      Int
  created_at              DateTime?        @db.Timestamp(0)
  updated_at              DateTime?        @db.Timestamp(0)
  products                products?        @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "purchase_return_details_product_id_foreign")
  purchase_returns        purchase_returns @relation(fields: [purchase_return_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "purchase_return_details_purchase_return_id_foreign")

  @@index([product_id], map: "purchase_return_details_product_id_foreign")
  @@index([purchase_return_id], map: "purchase_return_details_purchase_return_id_foreign")
}

model purchase_return_payments {
  id                 BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  purchase_return_id BigInt           @db.UnsignedBigInt
  amount             Int
  date               DateTime         @db.Date
  reference          String           @db.VarChar(255)
  payment_method     String           @db.VarChar(255)
  note               String?          @db.Text
  created_at         DateTime?        @db.Timestamp(0)
  updated_at         DateTime?        @db.Timestamp(0)
  purchase_returns   purchase_returns @relation(fields: [purchase_return_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "purchase_return_payments_purchase_return_id_foreign")

  @@index([purchase_return_id], map: "purchase_return_payments_purchase_return_id_foreign")
}

model purchase_returns {
  id                       BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  date                     DateTime                   @db.Date
  reference                String                     @db.VarChar(255)
  supplier_id              BigInt?                    @db.UnsignedBigInt
  supplier_name            String                     @db.VarChar(255)
  tax_percentage           Int                        @default(0)
  tax_amount               Int                        @default(0)
  discount_percentage      Int                        @default(0)
  discount_amount          Int                        @default(0)
  shipping_amount          Int                        @default(0)
  total_amount             Int
  paid_amount              Int
  due_amount               Int
  status                   String                     @db.VarChar(255)
  payment_status           String                     @db.VarChar(255)
  payment_method           String                     @db.VarChar(255)
  note                     String?                    @db.Text
  created_at               DateTime?                  @db.Timestamp(0)
  updated_at               DateTime?                  @db.Timestamp(0)
  purchase_return_details  purchase_return_details[]
  purchase_return_payments purchase_return_payments[]
  suppliers                suppliers?                 @relation(fields: [supplier_id], references: [id], onUpdate: NoAction, map: "purchase_returns_supplier_id_foreign")

  @@index([supplier_id], map: "purchase_returns_supplier_id_foreign")
}

model purchases {
  id                          BigInt                        @id @default(autoincrement()) @db.UnsignedBigInt
  date                        DateTime?                     @db.Date
  reference                   String?                       @unique(map: "reference") @db.VarChar(255)
  supplier_id                 BigInt?                       @db.UnsignedBigInt
  supplier_name               String?                       @db.VarChar(255)
  department_id               BigInt?
  users_id                    BigInt?
  tax_percentage              Int                           @default(0)
  tax_amount                  Int                           @default(0)
  discount_percentage         Int                           @default(0)
  discount_amount             Int                           @default(0)
  shipping_amount             Int                           @default(0)
  total_amount                Int?
  budget_amount               Decimal                       @default(0.00) @db.Decimal(15, 2)
  mandatory_amount            Decimal                       @default(0.00) @db.Decimal(15, 2)
  non_mandatory_amount        Decimal                       @default(0.00) @db.Decimal(15, 2)
  borrowed_amount             Decimal                       @default(0.00) @db.Decimal(15, 2)
  asset_amount                BigInt                        @default(0) @db.UnsignedBigInt
  master_budget_value         Int?
  master_budget_remaining     Int?
  master_budget_id            BigInt?
  borrowed_master_budget_id   BigInt?                       @db.UnsignedBigInt
  paid_amount                 Int?
  due_amount                  Int?
  status                      purchases_status?
  payment_status              String?                       @db.VarChar(255)
  payment_method              String?                       @db.VarChar(255)
  note                        String?                       @db.Text
  created_at                  DateTime?                     @db.Timestamp(0)
  updated_at                  DateTime?                     @db.Timestamp(0)
  closed_at                   DateTime?                     @db.Timestamp(0)
  closed_by                   BigInt?                       @db.UnsignedBigInt
  is_closed                   Boolean                       @default(false)
  po_id                       BigInt?                       @db.UnsignedBigInt
  pr_type                     String?                       @default("normal") @db.VarChar(255)
  purchase_budget_allocations purchase_budget_allocations[]
  purchase_details            purchase_details[]
